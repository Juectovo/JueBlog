# ---------- 数据库（Supabase → Project Settings → Database → Connection string / URI） ----------
# 运行时连接：事务池器（Transaction pooler，IPv4 可用，含 pgbouncer=true）
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# 迁移 / db push 专用：会话池器（Session pooler），配合 schema.prisma 的 directUrl
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ---------- NextAuth ----------
NEXTAUTH_URL="http://localhost:3000"
# 生成方式：openssl rand -base64 32
NEXTAUTH_SECRET=""

# ---------- GitHub OAuth App ----------
# 申请步骤见 docs/github-oauth-setup.md
GITHUB_ID=""
GITHUB_SECRET=""

# ---------- 邮件 Resend ----------
# Resend 控制台 → API Keys 创建；发信域名需在 Domains 中验证
# 注意：未验证域名时 Resend 只能发给你注册 Resend 的邮箱（测试模式限制）
RESEND_API_KEY=""
EMAIL_FROM="JueBlog <noreply@jueblog.com>"

# ---------- 邮件 SMTP（推荐：可发送给任意邮箱，无域名要求） ----------
# 使用 QQ/163 等邮箱的「授权码」发信（在邮箱设置中开启 SMTP 获取授权码，不是登录密码）
# 配置后优先于 Resend 使用。163 邮箱：smtp.163.com:465；QQ 邮箱：smtp.qq.com:465
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# ---------- AI 摘要（可选，OpenAI 兼容接口） ----------
# 不配置则编辑器的「AI 生成摘要」按钮提示未启用
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
